# Browser (public, safe to expose; baked into the build).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# Server routes (Vercel > Settings > Environment Variables, Production). Never VITE_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key: secret>
RESEND_API_KEY=<re_...: secret>
# An address on the domain verified in Resend.
OFFICE_FROM_EMAIL=JUSTUSED Office <office@justusedtech.org>
# The office's own https address: the links in every email.
OFFICE_BASE_URL=https://office.justusedtech.org
# Shared with the Supabase Vault value cron_secret (0003). 32+ random characters.
CRON_SECRET=<random secret>
# Optional: Mr Tito's alerts and 18:30 summary to this address instead of his login email.
OFFICE_MANAGER_EMAIL=
