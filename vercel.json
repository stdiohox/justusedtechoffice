{
  "rewrites": [
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "functions": {
    "api/cron/office-alerts.ts": {
      "maxDuration": 60,
      "includeFiles": "src/lib/**"
    },
    "api/office/knock-ping.ts": {
      "includeFiles": "src/lib/**"
    },
    "api/office/task-notify.ts": {
      "includeFiles": "src/lib/**"
    },
    "api/team/invite.ts": {
      "includeFiles": "src/lib/**"
    },
    "api/auth/recover.ts": {
      "includeFiles": "src/lib/**"
    }
  }
}
